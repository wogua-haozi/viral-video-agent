# Copy to .env.pilot in the project root; never commit the populated file.
# Use a hostname only (no http:// prefix), with DNS pointing to the trial host.
PILOT_DOMAIN=
PILOT_GATE_USER=
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
# Enclose the bcrypt hash in SINGLE QUOTES to preserve its dollar signs.
PILOT_GATE_HASH=''
# Keep the password of an existing business database unchanged until verified.
# For a new database, use a URL-safe random password.
POSTGRES_PASSWORD=
# Optional: URL-encoded connection URL when the existing password has @ / # etc.
# e.g. postgresql+asyncpg://user:ENCODED_PASSWORD@postgres:5432/database
PILOT_DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
